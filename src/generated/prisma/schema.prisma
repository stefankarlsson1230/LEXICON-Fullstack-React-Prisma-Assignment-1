generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// your models go here
model Movie {
  id    Int    @id @default(autoincrement())
  title String
  year  Int

  genres Genre[]

  @@map("movies")
}

model Genre {
  id    Int    @id @default(autoincrement())
  title String @unique

  movies Movie[]

  @@map("genres")
}
